static func has_key(key: String) -> bool:
	return _find(key, "en") != null


# People hired during a run: their names, filled in by the rules (EXTRA), and, for lines written per
# person, who to read instead: STAND_IN["hire3"] = ["hire_faker", "hire"] (their kind, then any hire).
static var EXTRA := {"ru": {}, "en": {}}
static var STAND_IN := {}


static func _find(key: String, in_lang: String):
	for table in [C.TASK_TEXT[in_lang], EXTRA[in_lang], S[in_lang]]:
		if table.has(key):
			return table[key]
	for id in STAND_IN:
		var parts := key.split(".")
		var i := parts.find(id)
		if i >= 0:
			for other in STAND_IN[id]:
				parts[i] = other
				var alt := ".".join(parts)
				for table in [EXTRA[in_lang], S[in_lang]]:
					if table.has(alt):
						return table[alt]
	return null


# Task names and requests come from data/tasks.tsv (C.TASK_TEXT); everything else from S.
static func t(key: String, args: Array = []) -> String:
	var found = _find(key, lang)
	if found == null:
		found = _find(key, "en")
	var s: String = found if found != null else key
	if args.is_empty():
		return s
	return s % _resolve(args)


# Keyed text with %s args and {named} placeholders filled in.
static func render(key: String, args: Array = [], names: Dictionary = {}) -> String:
	var s := t(key, args)
	if names.is_empty():
		return s
	var resolved := {}
	for k in names:
		resolved[k] = _resolve([names[k]])[0]
	return s.format(resolved)


# A line written straight in a scene (both languages) with its {named} placeholders filled in.
static func fill(ru: String, en: String, names: Dictionary = {}) -> String:
	var s := en if lang == "en" and en != "" else ru
	if names.is_empty():
		return s
	var resolved := {}
	for k in names:
		resolved[k] = _resolve([names[k]])[0]
	return s.format(resolved)


# The game's money: "250 куников", "1 coonic". A history line keeps "$cash:250" so it reads right in
# whichever language is on when it's shown.
static func cash(n: int) -> String:
	return "%d %s" % [n, cash_word(n)]


static func cash_word(n: int) -> String:
	var a := absi(n)
	if lang == "en":
		return "coonic" if a == 1 else "coonics"
	if a % 10 == 1 and a % 100 != 11:
		return "куник"
	if a % 10 in [2, 3, 4] and not (a % 100 in [12, 13, 14]):
		return "куника"
	return "куников"


static func person(id: String) -> String:
	return t("name.%s.nom" % id)


static func _resolve(args: Array) -> Array:
	var out := []
	for a in args:
		if a is String and a.begins_with("@"):
			out.append(t(a.substr(1)))
		elif a is String and a.begins_with("$cash:"):
			out.append(cash(int(a.substr(6))))
		else:
			out.append(a)
	return out
