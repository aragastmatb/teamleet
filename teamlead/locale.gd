		"setup.boss.X": "Chaos",
		"setup.boss.X.desc": "Bursts in for two hours with blazing eyes, calls everyone to the meeting room and runs off. Hardly ever sees you.",
		"setup.boss.random": "Whoever I get",
		"setup.boss.random.desc": "You'll figure her out as you go, like in real life.",
		"setup.me.techie": "Former engineer",
		"setup.me.techie.desc": "Strong hands: you can do almost any task yourself. Talking people round isn't your thing.",
		"setup.me.manager": "Former manager",
		"setup.me.manager.desc": "Hardly any hands-on skills, but more time for people, and you know how to talk to them.",
